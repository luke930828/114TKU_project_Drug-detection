# 複製成 .env.local 再填值。這個 .example 才進 git，.env.local 不進。
# 用法：docker compose -f deploy/docker-compose.yml --env-file .env.local up -d

# ---- 資料庫 ----
DB_USER=root
# ⚠️ 換一組新的！舊的 MySQLdrug2026 已經公開在 GitHub 上了
DB_PASSWORD=
DB_NAME=drug_prevention_db

# ---- 模組位址：單機版用 compose 服務名 ----
NLP_BASE_URL=http://nlp:8000
YOLO_BASE_URL=http://yolo:5000
CRAWLER_BASE_URL=http://crawler:8001

# ---- 網路行為：同機超快，timeout 可以短 ----
HTTP_TIMEOUT=10
HTTP_RETRIES=2

# ---- 模組間驗證 ----
# 隨便產一組：openssl rand -hex 32
INTERNAL_API_TOKEN=

# ---- 前端 ----
# 走 nginx proxy，所以填相對路徑就好
VITE_API_BASE_URL=/api
CORS_ORIGINS=http://localhost:8080

# ---- YOLO 權重放哪 ----
MODEL_DIR=../models

# ---- NLP 微調模型（Hugging Face Hub repo id）----
MODEL_ID=matt0513/drug-detection-xlm-roberta
